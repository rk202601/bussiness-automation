# ──────────────────────────────────────────────
# Google Maps Lead Scraper — Configuration
# ──────────────────────────────────────────────

# Target state for all leads
TARGET_STATE=Haryana

# Comma-separated list of cities to search
TARGET_CITIES=Gurugram,Faridabad,Panipat,Hisar,Ambala

# Comma-separated search keywords
SEARCH_KEYWORDS=LCD LED Repair,LCD LED Spare Parts,LED TV Repair

# ── Firebase / Firestore ───────────────────────
# Path to your Firebase service account JSON key file
# How to get it:
#   1. Go to Firebase Console → your project
#   2. Project Settings → Service Accounts tab
#   3. Click "Generate new private key" → download the JSON
#   4. Place the JSON file in your project directory and set the path below
FIREBASE_CREDENTIALS_FILE=firebase-credentials.json

# Firestore collection name where leads will be stored
FIRESTORE_COLLECTION=leads

# ── Browser settings ───────────────────────────
HEADLESS=true

# Delays (seconds) — tune for speed vs. detection risk
SCROLL_PAUSE_SEC=1.5
ACTION_DELAY_SEC=2.0
